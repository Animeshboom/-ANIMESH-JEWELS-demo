# ANIMESH JEWELS - Environment Configuration Template
# Copy this file to .env.local to configure custom endpoints or private proxies.

# Precious Metals Market API Provider (Default: Public Gold-API.com)
VITE_MARKET_API_PROVIDER="gold-api"
VITE_MARKET_API_BASE_URL="https://api.gold-api.com"

# Optional: Private Server Proxy / Enterprise Bullion API Key (if migrated behind custom backend)
# VITE_BULLION_API_KEY=""

# Refresh Polling Interval in milliseconds (default: 60000ms = 60s)
VITE_MARKET_REFRESH_INTERVAL_MS=60000
